{
  "name": "practicajs-pokememory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mock:firebase": "node mock/firebase-mock.mjs",
    "start": "npx --yes live-server --port=5500 --no-browser --watch=js,css,index.html",
    "dev": "npx --yes concurrently -k \"npm:mock:firebase\" \"npm:start\"",
    "lint": "eslint \"js/**/*.js\"",
    "htmlhint": "htmlhint \"index.html\"",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:open": "node scripts/run-e2e.mjs --open"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cypress": "^14.3.3",
    "eslint": "^8.57.1",
    "htmlhint": "^1.1.4"
  }
}
